{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:guard-request:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "file.mutate"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "$ref": "urn:ai-workflow:record:2#/$defs/path"
                  },
                  "before_sha256": {
                    "anyOf": [
                      {
                        "$ref": "urn:ai-workflow:record:2#/$defs/digest"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "after": {
                    "anyOf": [
                      {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "encoding": {
                                "const": "utf8"
                              },
                              "text": {
                                "type": "string",
                                "maxLength": 8388608
                              }
                            },
                            "required": [
                              "encoding",
                              "text"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "encoding": {
                                "const": "opaque"
                              },
                              "sha256": {
                                "$ref": "urn:ai-workflow:record:2#/$defs/digest"
                              },
                              "size_bytes": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "encoding",
                              "sha256",
                              "size_bytes"
                            ]
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "path",
                  "before_sha256",
                  "after"
                ]
              },
              "maxItems": 100,
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "changes"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "command.run"
            },
            "executable": {
              "$ref": "urn:ai-workflow:record:2#/$defs/guard_absolute_path"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 65536
              },
              "maxItems": 1000,
              "minItems": 0
            },
            "cwd": {
              "$ref": "urn:ai-workflow:record:2#/$defs/guard_cwd"
            }
          },
          "required": [
            "kind",
            "executable",
            "argv",
            "cwd"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "workflow.query"
            },
            "command": {
              "enum": [
                "check",
                "status",
                "validate",
                "context.inspect",
                "context.guard",
                "artifacts.inspect",
                "spec.check",
                "doctor",
                "guard.check"
              ]
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 65536
              },
              "maxItems": 1000,
              "minItems": 0
            }
          },
          "required": [
            "kind",
            "command",
            "argv"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "workflow.apply"
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation_version": {
                  "const": 3
                },
                "request_id": {
                  "$ref": "urn:ai-workflow:record:2#/$defs/id"
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "action": {
                  "enum": [
                    "record",
                    "prepare",
                    "select",
                    "start",
                    "verify",
                    "await",
                    "confirm",
                    "closeout",
                    "spec_sync",
                    "complete",
                    "pause",
                    "block",
                    "resume",
                    "refresh",
                    "context_bind",
                    "task_revise"
                  ]
                },
                "data": {
                  "type": "object"
                }
              },
              "required": [
                "operation_version",
                "request_id",
                "expected_revision",
                "action",
                "data"
              ]
            },
            "input_sha256": {
              "$ref": "urn:ai-workflow:record:2#/$defs/digest"
            }
          },
          "required": [
            "kind",
            "request",
            "input_sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git.stage"
            },
            "paths": {
              "type": "array",
              "items": {
                "$ref": "urn:ai-workflow:record:2#/$defs/path"
              },
              "maxItems": 1000,
              "minItems": 1
            },
            "cwd": {
              "$ref": "urn:ai-workflow:record:2#/$defs/guard_cwd"
            }
          },
          "required": [
            "kind",
            "paths",
            "cwd"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git.commit"
            },
            "paths": {
              "type": "array",
              "items": {
                "$ref": "urn:ai-workflow:record:2#/$defs/path"
              },
              "maxItems": 1000,
              "minItems": 1
            },
            "cwd": {
              "$ref": "urn:ai-workflow:record:2#/$defs/guard_cwd"
            },
            "index_sha256": {
              "$ref": "urn:ai-workflow:record:2#/$defs/digest"
            }
          },
          "required": [
            "kind",
            "paths",
            "cwd",
            "index_sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git.push"
            },
            "remote_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "remote_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "target_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "candidate_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "intent": {
              "enum": [
                "candidate",
                "progress_backup"
              ]
            },
            "cwd": {
              "$ref": "urn:ai-workflow:record:2#/$defs/guard_cwd"
            }
          },
          "required": [
            "kind",
            "remote_name",
            "remote_url",
            "target_branch",
            "candidate_commit",
            "intent",
            "cwd"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git.integrate"
            },
            "remote_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "target_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "pr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "candidate_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "base_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "integration_check_ref": {
              "$ref": "urn:ai-workflow:record:2#/$defs/ref"
            },
            "cwd": {
              "$ref": "urn:ai-workflow:record:2#/$defs/guard_cwd"
            }
          },
          "required": [
            "kind",
            "remote_url",
            "target_branch",
            "pr",
            "candidate_commit",
            "base_commit",
            "integration_check_ref",
            "cwd"
          ]
        }
      ]
    },
    "task_ref": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:record:2#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "context_snapshot_sha256": {
          "$ref": "urn:ai-workflow:record:2#/$defs/digest"
        },
        "task_definition_sha256": {
          "$ref": "urn:ai-workflow:record:2#/$defs/digest"
        }
      },
      "required": []
    },
    "authorization_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:record:2#/$defs/ref"
      },
      "maxItems": 1000,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "operation",
    "task_ref",
    "expected",
    "authorization_refs"
  ]
}
